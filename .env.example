# =============================================================================
# cat-directory-app — variables de entorno
#
# Copiar a `.env.local` (gitignored) solo si hace falta cambiar algo: los
# valores por defecto ya sirven para desarrollo local.
#
# **Todas son build-time y públicas.** Next inlinea `NEXT_PUBLIC_*` en el
# bundle del navegador al hacer `next build`.
# =============================================================================

# Base de catfact.ninja (pública, sin API key).
NEXT_PUBLIC_CAT_API_URL=https://xxxxxxxxxx
